{
  "name": "pi-pulse",
  "version": "1.0.0",
  "description": "A growing collection of crafted extensions for Pi Coding Agent",
  "type": "module",
  "author": "zhugez",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhugez/pi-pulse.git"
  },
  "homepage": "https://github.com/zhugez/pi-pulse#readme",
  "bugs": {
    "url": "https://github.com/zhugez/pi-pulse/issues"
  },
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "pi-extension",
    "antigravity",
    "gemini",
    "llm-provider",
    "llm-usage",
    "throughput",
    "ponytail"
  ],
  "engines": {
    "node": ">=22.15.0"
  },
  "packageManager": "pnpm@12.14.0",
  "onlyBuiltDependencies": [
    "@google/genai",
    "esbuild",
    "protobufjs",
    "@dietrichgebert/ponytail"
  ],
  "scripts": {
    "test": "bash scripts/test.sh",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run typecheck && pnpm test"
  },
  "pi": {
    "extensions": [
      "./extensions/startup-entry.ts",
      "./extensions/lens/index.ts",
      "./extensions/code-mode/index.ts",
      "./extensions/codex-pool/index.ts",
      "./extensions/antigravity/index.ts",
      "./extensions/gemini-web/index.ts",
      "./extensions/antigravity/features/google-search.ts",
      "./extensions/antigravity/features/generate-image.ts",
      "./extensions/claude-cli/index.ts",
      "./extensions/exomind/index.ts",
      "./node_modules/@dietrichgebert/ponytail/pi-extension/index.js"
    ],
    "skills": [
      "./node_modules/@dietrichgebert/ponytail/skills"
    ]
  },
  "license": "MIT",
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.80.0",
    "@earendil-works/pi-coding-agent": ">=0.80.0",
    "@earendil-works/pi-tui": ">=0.80.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.86.1",
    "@earendil-works/pi-coding-agent": "^0.86.1",
    "@earendil-works/pi-tui": "^0.87.1",
    "@types/cross-spawn": "^6.0.6",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@dietrichgebert/ponytail": "4.12.0",
    "cross-spawn": "^7.0.6",
    "undici": "^8.11.2"
  },
  "bundleDependencies": [
    "@dietrichgebert/ponytail"
  ]
}
